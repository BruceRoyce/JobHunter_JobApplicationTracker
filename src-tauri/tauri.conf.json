{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Job Application Tracker",
  "version": "1.0.1",
  "identifier": "com.bruceroyce.job-hunter-tracker",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "deno task build && deno compile --allow-net --allow-read --allow-write --allow-env --allow-sys --output src-tauri/binaries/server-x86_64-pc-windows-msvc.exe server/main.ts",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Application Tracker | Job Hunter",
        "width": 800,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Bruce Royce",
    "copyright": "© 2026 Bruce Royce. MIT License.",
    "category": "Productivity",
    "shortDescription": "Track every job application in one private place.",
    "externalBin": ["binaries/server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
